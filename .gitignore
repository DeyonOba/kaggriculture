# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Arena outputs
arena/results/

# Public competition agents pulled from other people's notebooks (tools/fetch_public_agents.py)
arena/agents/pub-*
# Throwaway knob variants built by rl/export.py --freeze var-*
arena/agents/var-*
# Experiment bundles. Each is a ~115 KB frozen copy of a champion with one
# patch; they are reproducible from their tools/make_*_variant.py builder, so
# the builder is the artifact worth keeping, not the bundle.
arena/agents/[abcfghkmorvwx]-*
arena/agents/h9-*
arena/agents/h1[0-3]-*
arena/agents/g[0-9]*-*
arena/agents/tE[0-9]-*
arena/agents/p1-*
arena/agents/n1-*
arena/agents/bc-*
arena/agents/cl-*
arena/agents/d-*
arena/agents/onm*
arena/agents/dev-exec
arena/agents/match-*
arena/agents/tape-*

# Rendered test replays: 3 GB of HTML, regenerate with tools/rule_tests.py
tests/replays/
# Throwaway chain-audit variants built by tools/make_chain_variant.py

# Replay/debug artifacts
kaggriculture.html
player_*_obs.json
replays/

# Training runs (weights snapshots are large; champions live in kagent/weights.py + arena/agents/)
rl/runs/

# Datasets live in a Kaggle Dataset (tools/data.py); only the manifest + README are tracked
rl/datasets/*
!rl/datasets/README.md
!rl/datasets/MANIFEST.json
!rl/datasets/episodes_ledger.json
*.pt
nohup.out

# Rendered HTML replays (~46 MB each, regenerate with tools/render_game.py)
replay-*.html

arena/agents/x-glut*
arena/agents/x-fut*
.snapshots/

# rlv3 regenerable artifacts. The scorecard trace cache alone is 47M and is
# rebuilt on demand (`--fresh`); eval/build/* are bundles the ladder script
# writes; runs/ is the training driver's own output, like rl/runs/.
rlv3/eval/scorecard_traces/
rlv3/eval/build/
rlv3/runs/
